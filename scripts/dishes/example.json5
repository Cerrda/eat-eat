// 批量新增菜品的示例。复制一份再改，然后运行 pnpm dishes:import。
// 封面路径相对本目录（scripts/dishes）。食材和步骤都写成数组。
[
  {
    // 菜名。必填，最多 20 个字。这间厨房里已有同名菜时会跳过。
    "name": "番茄炒蛋",
    // 分类名。1 到 6 个字。这间厨房还没有同名分类时会自动新建。不写则不归类。
    "category": "家常",
    // 食材。可以是空数组，也可以不写。每条最多 200 个字，最多 80 条。
    "ingredients": [
      "番茄 2 个",
      "鸡蛋 3 个"
    ],
    // 步骤。可以是空数组，也可以不写。每步最多 200 个字，最多 30 步。
    "steps": [
      "番茄切块，鸡蛋打散",
      "先把蛋炒熟盛出，再炒番茄，最后合在一起"
    ],
    // 来源链接。可以不写。最多 500 个字。
    "sourceUrl": "https://www.xiaohongshu.com/explore/example",
    // 封面。相对本目录，必填。例如把图放在 scripts/dishes/covers/tomato.jpg。
    "cover": "covers/tomato.jpg"
  }
]
