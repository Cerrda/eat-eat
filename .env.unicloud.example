# 复制本文件为 .env.unicloud.local 后填写。凭证在 uniCloud 控制台的服务空间详情里。
# https://unicloud.dcloud.net.cn
# .env.unicloud.local 不要提交。pnpm dev / pnpm build 会把这些值注入客户端。

UNICLOUD_PROVIDER=alipay
UNICLOUD_SPACE_NAME=
UNICLOUD_SPACE_ID=
UNICLOUD_SPACE_APP_ID=
UNICLOUD_ACCESS_KEY=
UNICLOUD_SECRET_KEY=

# 若改用阿里云：把目录 uniCloud-alipay 改名为 uniCloud-aliyun，并改用下面几项。
# UNICLOUD_PROVIDER=aliyun
# UNICLOUD_SPACE_NAME=
# UNICLOUD_SPACE_ID=
# UNICLOUD_CLIENT_SECRET=
# UNICLOUD_ENDPOINT=https://api.next.bspapp.com
